programa {
  funcao inicio() {
    
real N1,N2,N3,MEDIA
escreva("Digite a primeira:")
leia (N1)
escreva("Digite a segunda:")
leia (N2)
escreva("Digite a terceira:")
leia (N3)

MEDIA = (N1+N2+N3)/3

se (MEDIA>=7)
{
  escreva("aprovado por media")
}
senao
{
escreva("reprovado por media")
}




}
}
