programa {
  funcao inicio() {

real n1, n2 ,n3, media

 escreva ("digite sua primeira nota: ")
 leia (n1) 
 
escreva ("digite sua segunda nota: ")
 leia (n2) 

 escreva ("digite sua terceira nota: ")
 leia (n3) 

 media = (n1+n2+n3)/3
se (media>=7) 
 escreva ("aprovado com a média:"+ media)
senao 
 escreva ("reprovado com a média:"+media)
  }
}
